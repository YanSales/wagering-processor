# Modelo do ambiente de testes de integração e smoke. Copie para `.env.test` (ignorado pelo Git).
# Valores fictícios: o banco de teste é descartável (tmpfs) e exposto apenas em 127.0.0.1.
# DB_NAME deve terminar com `_test`; os testes se recusam a rodar contra outro banco.

DB_HOST=127.0.0.1
DB_PORT=55432
DB_USER=wagering_test
DB_PASSWORD=test-only-not-a-secret
DB_NAME=wagering_test
