# Modelo de variáveis de ambiente para desenvolvimento local.
# Copie para `.env` (ignorado pelo Git). Valores apenas ilustrativos: troque a senha localmente
# e nunca use estes valores fora do ambiente de desenvolvimento.

# HTTP
PORT=3000

# PostgreSQL — usadas pela aplicação, pelo CLI do MikroORM e pelo compose.yaml.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wagering
DB_PASSWORD=change-me-local-only
DB_NAME=wagering

# SQS: ElasticMQ local (`bun run sqs:up`). Credenciais ficticias exigidas pelo SDK.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-fake-access-key
AWS_SECRET_ACCESS_KEY=local-fake-secret-key
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_WAGER_EVENTS_QUEUE=wager-events.fifo
SQS_WAGER_EVENTS_DLQ=wager-events-dlq.fifo
