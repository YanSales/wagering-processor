{
  "name": "wagering-processor",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed Wagering Processor: solução para o desafio técnico da Jungle Gaming",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0 <2"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:smoke": "bun test test/smoke",
    "test:integration": "bun test test/integration",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@nestjs/testing": "12.2.0",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
