{
  "name": "wagering-processor",
  "version": "0.0.0",
  "private": true,
  "description": "Distributed Wagering Processor: solução para o desafio técnico da Jungle Gaming",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0 <2"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:unit && bun run test:integration && bun run test:smoke",
    "test:unit": "bun --no-env-file test test/unit",
    "test:smoke": "bun --env-file=.env.test test test/smoke",
    "test:integration": "bun --env-file=.env.test test test/integration",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:test:up": "docker compose -f compose.test.yaml --env-file .env.test up -d --wait",
    "db:test:down": "docker compose -f compose.test.yaml --env-file .env.test down",
    "migration:create": "bun --bun mikro-orm migration:create",
    "migration:up": "bun --bun mikro-orm migration:up",
    "migration:down": "bun --bun mikro-orm migration:down",
    "migration:list": "bun --bun mikro-orm migration:list",
    "migration:pending": "bun --bun mikro-orm migration:pending",
    "migration:check": "bun --bun mikro-orm migration:check",
    "check": "bun run lint && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@mikro-orm/cli": "7.2.5",
    "@nestjs/testing": "12.2.0",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@mikro-orm/core": "7.2.5",
    "@mikro-orm/migrations": "7.2.5",
    "@mikro-orm/nestjs": "7.1.0",
    "@mikro-orm/postgresql": "7.2.5",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "overrides": {
    "multer": "2.5.0"
  }
}
